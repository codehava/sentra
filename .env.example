# Supabase Configuration
# Copy this file to .env.local for local development

# Local Development (Supabase Local)
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=your-local-anon-key

# UAT Environment (set in Vercel for UAT deployment)
# VITE_SUPABASE_URL=https://your-uat-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-uat-anon-key

# Production Environment (set in Vercel for Production deployment)
# VITE_SUPABASE_URL=https://your-prod-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-prod-anon-key

# Cloudflare R2 Storage
# Get these from Cloudflare dashboard > R2 > Manage R2 API Tokens
VITE_R2_ACCOUNT_ID=your-account-id
VITE_R2_ACCESS_KEY_ID=your-access-key-id
VITE_R2_SECRET_ACCESS_KEY=your-secret-access-key
VITE_R2_BUCKET_NAME=sentra-files
VITE_R2_PUBLIC_URL=https://pub-xxx.r2.dev
